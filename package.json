{
  "name": "tessaloom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "build": "pnpm --filter web build && pnpm --filter worker build && pnpm --filter @tessaloom/db build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && pnpm -r --if-present typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "test:container": "node scripts/container-smoke.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:generate": "pnpm --filter @tessaloom/db generate",
    "db:check": "pnpm --filter @tessaloom/db check",
    "db:migrate": "pnpm --filter @tessaloom/db build && pnpm --filter @tessaloom/db migrate",
    "test:deployment": "node deploy/smoke.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "0.131.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
