# Local synthetic demonstration. Never use these placeholders for public hosting.
APP_ENV=development
NODE_ENV=development
TL_ROLE=all
HOSTNAME=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://tessaloom:local-development-only@127.0.0.1:5432/tessaloom
SESSION_SECRET=replace-with-at-least-32-random-bytes
SHARE_TOKEN_PEPPER=replace-with-another-32-random-bytes
LOG_LEVEL=info
QLOO_MODE=synthetic
# Hackathon endpoint (non-secret). Both must be the same exact URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Raw Qloo responses are not persisted until storage permission is confirmed.
QLOO_RAW_RETENTION=off
QLOO_RATE_LIMIT_PER_MIN=20
GLOBAL_DAILY_QLOO_CALLS=0
GLOBAL_DAILY_LLM_USD=0
LLM_PROVIDER=scripted
LLM_MODEL=scripted-demo
LLM_FALLBACK_MODEL=scripted-demo-fallback
LLM_MODE=standard
# Future live adapters use worker-only secrets injected by the platform.
# QLOO_API_KEY=<provided-outside-the-repository>
# ANTHROPIC_API_KEY=<provided-outside-the-repository>
# DATABASE_URL_MIGRATOR=<release-command-only>
# Local personal use only: LLM_PROVIDER=claude-subscription runs the official Agent SDK with your
# own Claude Pro/Max login (`claude` signed in; no ANTHROPIC_API_KEY). Refused outside
# development/test. Use LLM_MODEL=claude-sonnet-5-5. See docs/CLAUDE_SUBSCRIPTION_LOCAL_ACCEPTANCE.md.
CLAUDE_SUBSCRIPTION_LOCAL_APPROVED=off
CLAUDE_SUBSCRIPTION_MAX_REQUESTS=0
# Gemini is opt-in; keep all gates off until account quota and data rights are verified.
# Set LLM_PROVIDER=gemini and LLM_MODEL to an account-verified supported model.
GEMINI_FREE_TIER_CONFIRMED=off
GEMINI_DATA_SHARING_APPROVED=off
GEMINI_MAX_REQUESTS=0
GEMINI_TIMEOUT_MS=60000
# GEMINI_API_KEY belongs in a private worker environment, never in this file.

# Preferred live evaluation provider; paid access remains disabled.
# Keep the actual key only in ~/.config/tessaloom/deepseek.env (0600, parent 0700).
# Set LLM_PROVIDER=deepseek only for an approved local synthetic evaluation.
# standard selects deepseek-v4-pro; economy explicitly selects deepseek-flash.
DEEPSEEK_LIVE_APPROVED=off
DEEPSEEK_MAX_REQUESTS=0
DEEPSEEK_BUDGET_CNY=0
# Required only after explicit current tariff/FX review; do not guess these values.
# DEEPSEEK_USD_PER_CNY=
# DEEPSEEK_PRICING_VERIFIED_AT=
