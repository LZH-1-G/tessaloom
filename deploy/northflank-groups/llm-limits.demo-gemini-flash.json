{
  "name": "tessaloom-llm-limits",
  "description": "Prepared, not applied. Public judge demo with real Gemini 3.8 Flash (paid Standard) on synthetic Qloo data only: 2.00 USD per day global, 0.50 per workspace and experiment. Inert until the owner sets the paid-tier approval and pricing review (docs/submission/DEMO_DEPLOYMENT.md)",
  "type": "config",
  "secretType": "environment",
  "priority": 10,
  "restrictions": {
    "restricted": true,
    "nfObjects": [
      {
        "id": "tessaloom",
        "type": "service"
      }
    ]
  },
  "secrets": {
    "variables": {
      "LLM_PROVIDER": "gemini",
