# PROPOSED public Claude configuration. NOT APPLIED. Requires explicit owner approval.
# Differs from northflank.env.example only in the LLM provider and the bounded first-experiment
# caps. ANTHROPIC_API_KEY (Claude Console) goes in Northflank's restricted runtime secrets,
# never in this file, build args or chat. The owner's Claude subscription is never used here
# (Anthropic does not permit routing public users' requests through a personal plan).
NODE_ENV=production
APP_ENV=production
TL_ROLE=all
PORT=3000
HOSTNAME=0.0.0.0
QLOO_MODE=live
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
QLOO_RAW_RETENTION=off
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_MODEL=claude-sonnet-5-5
LLM_MODE=standard
# Keep access off until the key is in place and the first experiment is approved; then issue a
# short-lived judge grant (invite) via the admin CLI. Never open anonymous paid generation.
RUN_ACCESS=off
# First authorized paid experiment: USD 0.50 total, serial, one run at a time.
GLOBAL_DAILY_LLM_USD=0.50
WORKSPACE_DAILY_LLM_USD=0.50
EXPERIMENT_LLM_USD=0.50
GLOBAL_DAILY_QLOO_CALLS=60
MAX_WORKING_RUNS=1
MAX_ACTIVE_RUNS_PER_WORKSPACE=1
WORKSPACE_DAILY_RUNS=1
DEEPSEEK_LIVE_APPROVED=off
DEEPSEEK_MAX_REQUESTS=0
DEEPSEEK_BUDGET_CNY=0
GEMINI_FREE_TIER_CONFIRMED=off
GEMINI_DATA_SHARING_APPROVED=off
GEMINI_MAX_REQUESTS=0
CLAUDE_SUBSCRIPTION_LOCAL_APPROVED=off
CLAUDE_SUBSCRIPTION_MAX_REQUESTS=0
TL_WEB_MAX_OLD_SPACE_MB=128
TL_WORKER_MAX_OLD_SPACE_MB=192
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=info
