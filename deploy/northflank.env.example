# Runtime configuration only. Paste through Northflank's runtime variable editor after approval.
# No provider credentials, database URI, session secret or pepper belong in this file or build args.
NODE_ENV=production
APP_ENV=production
TL_ROLE=all
PORT=3000
HOSTNAME=0.0.0.0
QLOO_MODE=live
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
QLOO_RAW_RETENTION=off
LLM_PROVIDER=deepseek
LLM_MODE=economy
RUN_ACCESS=off
GLOBAL_DAILY_LLM_USD=0
GLOBAL_DAILY_QLOO_CALLS=0
WORKSPACE_DAILY_LLM_USD=0
EXPERIMENT_LLM_USD=0
MAX_WORKING_RUNS=1
MAX_ACTIVE_RUNS_PER_WORKSPACE=1
WORKSPACE_DAILY_RUNS=1
DEEPSEEK_LIVE_APPROVED=off
DEEPSEEK_MAX_REQUESTS=0
DEEPSEEK_BUDGET_CNY=0
GEMINI_FREE_TIER_CONFIRMED=off
GEMINI_DATA_SHARING_APPROVED=off
GEMINI_MAX_REQUESTS=0
TL_WEB_MAX_OLD_SPACE_MB=128
TL_WORKER_MAX_OLD_SPACE_MB=192
# Conservative shared-edge throttle until Northflank header sanitization is verified.
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=info
