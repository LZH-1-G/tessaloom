# Non-secret template. Supply private files separately; never commit populated secrets.
APP_IMAGE=tessaloom:m10b
PRIVATE_DIR=/absolute/private/tessaloom
TLS_DOMAIN=your-reviewed-hostname.duckdns.org
ACME_EMAIL=your-certificate-contact@example.invalid
# Keep loopback binding during preparation. Public 80/443 requires owner approval.
BIND_IP=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
RUN_ACCESS=off
GLOBAL_DAILY_LLM_USD=0
GLOBAL_DAILY_QLOO_CALLS=0
